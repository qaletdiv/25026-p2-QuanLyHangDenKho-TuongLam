# Copy to `.env` beside docker-compose.yml on the server (gitignored). Compose reads it
# for ${...} substitution. App settings (NetSuite, FedEx, SMTP…) stay in backend/.env.

# Public origin users type in the browser — used for CORS and links in emails.
PUBLIC_URL=https://excel.qzz.io

# Shared by backend AND frontend; must be identical. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

POSTGRES_DB=tentree_portal
POSTGRES_USER=tentree
# Avoid @ : / in the password — it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
