// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs
//
// ============================================================================
//  tentree Supply Chain Portal — 3NF redesign (JSON → Aurora PostgreSQL target)
//  Full audit + rationale: backend/SCHEMA_REDESIGN.md
// ============================================================================
//
// SCOPE: MAINLINE + SMS — two fully separate datasets in one schema file.
// Mainline and SMS share NO transactional tables (not even the PO hierarchy:
// SMS has its own sms_pos/sms_po_lines — decision 2026-07-02). The old
// `type: "sms" | "mainline"` discriminator column is GONE — table membership
// replaces it. Shared = reference/master data ONLY (suppliers, seasons,
// warehouse_facilities, allocation_channels, statuses, couriers, product_skus).
// Sources of truth: mainline POs ← WIP import (NS sync future); SMS POs ←
// NetSuite sync (custbody_tt_po_type='smm').
//
// ----------------------------------------------------------------------------
//  PO IDENTITY — three nested grains (the lifecycle of a mainline PO)
// ----------------------------------------------------------------------------
//  Step 1  NetSuite  master PO          → po_masters     PK = trn_number (TRN)
//          The TRN is the master PO number. It is assigned once and NEVER
//          changes through any split, so it is the stable header identity.
//  Step 2  NetSuite  warehouse split    → po_orders      PK = po_number
//          One TRN fans out to many po_numbers, one per receiving warehouse.
//          po_number is unique at THIS grain.
//  Step 3  WIP upload air/sea split     → *_po_legs      PK = surrogate id,
//                                                          NK = (po_number, mode, crd)
//          A po_number splits into Air + Sea legs (same po_number, different
//          mode), optionally into CRD waves. This is the only grain where
//          po_number repeats. Verified on live data (82 legs):
//            28 TRNs → 67 po_numbers → 82 legs
//            (po_number, mode, crd) is UNIQUE — 0 collisions.
//
//  Bookings / CI / shipments attach at the LEG grain and key on the leg's
//  surrogate id (kept purely as a convenient FK target; the real key is the NK).
//
// ----------------------------------------------------------------------------
//  TWO WRITE PATHS — clean field ownership, no preserve-hack
// ----------------------------------------------------------------------------
//  NetSuite sync  →  writes po_masters, po_orders, po_order_lines  (never legs)
//                    [FUTURE for mainline — today NS sync serves SMS only; the
//                     WIP import bootstraps missing masters/orders meanwhile]
//  WIP import     →  writes *_po_legs, *_po_leg_lines              (never master/order)
//  Because they write different tables, a re-sync cannot clobber WIP legs and a
//  WIP import cannot clobber NetSuite headers — the legacy "preserve portal
//  fields / Mixed-row splice" logic disappears.
//
//  Ingestion business rules (backend policy — recorded here, enforced in code):
//    R1. NetSuite re-sync MAY overwrite a po_orders/po_masters row only when NO
//        booking or shipment references its legs (e.g. qty 10→20 is fine while
//        unbooked). If a linked booking/shipment exists, protect the row.
//    R2. If a NetSuite total conflicts with the sum of WIP leg allocations,
//        FLAG FOR REVIEW (do not auto-resolve).
//    R3. WIP import always overwrites/updates legs — the importer is the source
//        of truth for the air/sea split.
//
//  DERIVED DATA IS NEVER STORED — PO lifecycle state, master/warehouse totals,
//  logistics-date rollups and fulfillment are computed via the views at the end.
// ============================================================================


// ===========================================================================
//  SHARED REFERENCE / MASTER DATA  (used by BOTH modules)
// ===========================================================================

// `name` unique is enforced case/punctuation-INSENSITIVELY (utils/nameKey.supplierKey):
// NetSuite spells vendors "Best Star Fashions Co., Ltd." where the master data holds
// "Best Star Fashions Co Ltd" — one vendor, so one row. Six such duplicate pairs were
// merged 2026-08-12. In Postgres: a functional unique index over the same expression
// (the key is derived from `name` — never a stored column).
Table suppliers {                       // resolves supplier-fact duplication (PO.coo, vendor_name)
  id            varchar [pk]
  name          varchar [unique, not null]
  country       varchar                 // source of truth for old PO.coo
  address       varchar
  port_of_loading varchar
}

// LEGACY warehouses — retained for SMS. Conflates two facts in `name`
// ("NRI US Reserved" = facility + channel). The normalized mainline module
// decomposes it into warehouse_facilities + allocation_channels (below).
Table warehouses {
  id            varchar [pk]
  name          varchar [unique, not null]
  country       varchar
  city          varchar
  email         varchar
  address       varchar
  port_of_discharge varchar
}

// Physical destination — the only thing the freight forwarder ships to
// (NRI US, NRI CA, Direct US, Direct CAN). Data: migrated/warehouse_facilities.json.
Table warehouse_facilities {
  id            varchar [pk]
  name          varchar [unique, not null]
  country       varchar
  city          varchar
  port_of_discharge varchar
  address       varchar
}

// Internal inventory bucket — orthogonal to where cargo physically goes
// (Reserved / First). An attribute of the PO order, NOT the shipment.
Table allocation_channels {
  id   varchar [pk]
  name varchar [unique, not null]
}

// Ocean ports (POL/POD) and container type — small lookups for the shipment header.
Table ports {
  id      varchar [pk]
  code    varchar [unique]   // UN/LOCODE: CNSHA, USLAX…
  name    varchar
  country varchar
}
Table container_types {
  id   varchar [pk]
  name varchar [unique, not null]   // FCL / LCL
}

// Carriers, despite the name — the table holds parcel couriers (FedEx, DHL) AND
// freight forwarders (Ceva). Renaming it to `carriers` is deferred debt: every SMS
// reference would move with it.
Table couriers {                        // SMS-leaning but shared lookup
  id   varchar [pk]
  name varchar [unique, not null]
  // Does finance receive SEPARATE freight & duty invoices from this carrier?
  //   true  (forwarders, e.g. Ceva) → landed cost is the ACTUAL off those invoices
  //   false (parcel couriers, FedEx/DHL) → no traceable invoice, so landed cost is
  //         ESTIMATED as commercial-invoice value × landed_cost_rates
  // The flag lives HERE because it is a property of the carrier, not of any one
  // shipment — so the basis stays DERIVED per read and no transaction row stores it.
  // Read by the MAINLINE landed-cost path only; SMS keeps its own booked/unbooked
  // rule (the two modules' landed-cost paths stay separate by design).
  provides_cost_invoices boolean [default: true]
}

Table modes {                           // Sea FCL / Air / Courier
  id   varchar [pk]
  name varchar [unique, not null]
}

Table incoterms {                       // FOB / DDP / DAP …
  id   varchar [pk]
  name varchar [unique, not null]
}

Table statuses {                        // gains module + category to split diverging vocab
  id        varchar [pk]
  name      varchar [not null]
  module    varchar [note: 'mainline | sms | both']
  category  varchar [note: 'booking | shipment']
  color     varchar
  sort_order integer

  indexes {
    (module, name) [unique]
  }
}

Table seasons {                         // was free-text season strings (FW26, SS27)
  id   varchar [pk]
  code varchar [unique]
}

// Per-season delivery KPI gates. A shipment's E-DEL ≤ ontime_by → On Time;
// ≤ atrisk_by → At Risk; later → Late. The timeliness axis is DERIVED from these
// at read-time (reports module), never stored on the shipment. One row per season.
Table production_schedules {
  season_id varchar [pk, ref: > seasons.id]
  ontime_by date
  atrisk_by date
}

// Standard lead time per (mode, journey segment) in days — the planning yardstick.
// Segments partition the door-to-received journey: production_handover (CRD →
// cargo received), origin_dwell (received → ETD POL), port_to_port (ETD → ETA),
// destination_leg (ETA POD → E-DEL), receiving (E-DEL → ATA, the +5 rule as data).
// Used by reports to (a) project an E-DEL for unbooked legs (CRD + Σ segments),
// (b) name the slipped segment when a shipment runs late. Actual durations are
// DERIVED from shipment dates at read-time and never stored.
Table transit_time_standards {
  id      varchar [pk]
  mode_id varchar [not null, ref: > modes.id]
  segment varchar [not null]             // production_handover | origin_dwell | port_to_port | destination_leg | receiving
  days    integer [not null]

  indexes {
    (mode_id, segment) [unique]
  }
}

// ---- SKU master (shared product catalogue; both modules + CI reference it) ----
Table product_skus {                    // one atomic SKU row, deduped from PO/CI/WIP data
  sku_code     varchar [pk]
  style_color  varchar
  item_name    varchar
  description  varchar
  colorway     varchar
  size         varchar
  hts_code     varchar
  unit_price   decimal                  // list price; line-level overrides allowed
  upc          varchar                  // NS standard item field (upccode)
  gender       varchar                  // NS custom item fields (custitem_*, env-mapped);
  category     varchar                  //   CI/packing-list fallback when the vendor's
  composition  varchar                  //   uploaded sheet omits the column
  knit_woven   varchar
}


// ===========================================================================
//  PURCHASE ORDERS — shared upstream hierarchy (NetSuite-owned)
//  po_masters (TRN) → po_orders (po_number) → order lines
//  Mainline legs (air/sea) modeled below. SMS legs are out of scope for now.
// ===========================================================================

Table po_masters {                      // STEP 1 — NetSuite master PO. PK is the stable TRN.
  trn_number    varchar [pk]            // Tentree Internal PO # — never changes through splits
  supplier_id   varchar [ref: > suppliers.id]
  season_id     varchar [ref: > seasons.id]
  main_shoulder varchar                 // Main / Shoulder
  netsuite_id   varchar
  // total order qty per SKU = SUM of child po_order_lines → DERIVED (view), not stored
}

Table po_orders {                       // STEP 2 — warehouse split. One per (TRN, warehouse).
  po_number     varchar [pk]            // unique at this grain (repeats only in legs)
  trn_number    varchar [ref: > po_masters.trn_number]
  netsuite_id   varchar                 // NS PO internal id at the COMPONENT grain —
                                        // Item Receipts attach here (createdfrom). The
                                        // po_masters copy is lossy when a TRN spans POs.
  // conflated warehouse decomposed into two independent facts (3NF):
  facility_id           varchar [ref: > warehouse_facilities.id]   // physical destination
  allocation_channel_id varchar [ref: > allocation_channels.id]    // Reserved/First (nullable)
  coo_country           varchar                                    // country of origin (the goods)
  // mode is 'Sea' by default here; the real Air/Sea split happens at the leg grain
  // NOTE: this hierarchy is MAINLINE-ONLY (WIP-import-sourced today; a mainline
  // NetSuite sync may come later). SMS POs live in their own sms_pos table —
  // the two datasets share NO transactional tables (decision 2026-07-02).
}

Table po_order_lines {                  // NetSuite-owned per-SKU ordered qty (warehouse grain)
  id            varchar [pk]
  po_number     varchar [ref: > po_orders.po_number]
  sku_code      varchar [ref: > product_skus.sku_code]
  ordered_qty   integer
  unit_price    decimal

  indexes {
    (po_number, sku_code) [unique]
  }
}


// ===========================================================================
//  MAINLINE MODULE  (ocean/air freight — POL/POD, lots, packing lists)
//  Legs (air/sea) are WIP-owned. NO shared transactional tables with SMS.
// ===========================================================================

Table mainline_po_legs {                // STEP 3 — air/sea split (WIP). po_number repeats by mode.
  id            varchar [pk]            // convenience FK target; NK is (po_number, mode_id, crd)
  po_number     varchar [ref: > po_orders.po_number]
  mode_id       varchar [ref: > modes.id]          // Sea FCL / Air
  incoterm_id   varchar [ref: > incoterms.id]
  crd           date                                // cargo ready date (WIP)
  // planned logistics dates from WIP; actuals live on the shipment and override at read-time:
  etd_pol       date
  e_del         date

  indexes {
    (po_number, mode_id, crd) [unique, note: 'the real natural key — verified 0 collisions']
  }
}

Table mainline_po_leg_lines {           // WIP-owned per-SKU allocation to this air/sea leg
  id            varchar [pk]
  leg_id        varchar [ref: > mainline_po_legs.id]
  sku_code      varchar [ref: > product_skus.sku_code]
  allocated_qty integer

  indexes {
    (leg_id, sku_code) [unique]
  }
  // R2: SUM(allocated_qty per sku across a po_number's legs) vs po_order_lines.ordered_qty
  //     → reconciliation view; mismatch is flagged for review, never auto-resolved.
}

Table mainline_bookings {               // no copied supplier/po labels — all via FK
  id            varchar [pk]
  booking_number varchar [unique, not null]
  supplier_id   varchar [ref: > suppliers.id]          // single source (was vendor_name + supplier)
  incoterm_id   varchar [ref: > incoterms.id]
  cargo_ready_date date
  // PLANNED carrier — the commercial decision the booking IS ("book with FedEx/DHL,
  // or book with a freight forwarder"). Copied onto the shipment at approve.
  // NOT the same fact as mainline_shipments.courier_id, which is what ACTUALLY
  // carried it — same plan-vs-actual split as booked units vs shipped units. The
  // variance is derived at read, never stored.
  courier_id    varchar [ref: > couriers.id]
  booking_status_id varchar [ref: > statuses.id]
  submitted_at  timestamp
  approved_at   timestamp
}

// Junction (M:N booking ↔ leg). Keys on the leg surrogate id, not po_number.
// BOOKABLE GRAIN = LEG ONLY. A PO is bookable only after step 3 (air/sea split
// into legs); a forecast/warehouse-only PO with no legs cannot be booked. The
// FK to mainline_po_legs (never to po_orders/po_masters) enforces this.
Table mainline_booking_po_legs {
  id            varchar [pk]
  booking_id    varchar [ref: > mainline_bookings.id]
  leg_id        varchar [ref: > mainline_po_legs.id]
  units         integer
  cartons       integer
  weight_kg     decimal
  cbm           decimal

  indexes {
    (booking_id, leg_id) [unique]
  }
}

Table mainline_commercial_invoices {    // 1:1 with booking; line items flattened out
  id            varchar [pk]
  booking_id    varchar [ref: - mainline_bookings.id, unique]
  invoice_number varchar
  invoice_date  date
  source        varchar                  // 'shipment_data' | 'upload'
  status        varchar                  // 'confirmed' | 'draft'
  confirmed_at  timestamp                // event fact (when confirmed); null while draft
  file_url      varchar
  // NOT stored (derived from ci_line_items at read-time): unmatched_sku_count,
  // total_matched_qty, total_unmatched_qty — every CI response computes them.
}

// DERIVED, NOT STORED (folded 2026-07-07 — see modules/mainline/ci/ciLines.js).
// CI line items are computed at read-time from mainline_packing_cartons, grouped
// by (booking, sku): qty = Σ pcs_per_ctn, weight = Σ net_weight_kgs, cbm = Σ from
// measure_cm, matched_leg_id = the carton's leg. Shape kept here for reference /
// the read-time projection; there is no mainline_ci_line_items.json table anymore.
// (SMS derives its CI lines the same way — this brings mainline in line.)
Table mainline_ci_line_items {          // one row per SKU (was nested ci.line_items[])
  id            varchar [pk]
  invoice_id    varchar [ref: > mainline_commercial_invoices.id]
  sku_code      varchar [ref: > product_skus.sku_code]
  matched_leg_id varchar [ref: > mainline_po_legs.id, note: 'key on leg id, not po_number']
  qty           integer
  weight_kg     decimal
  cbm           decimal
  match_status  varchar
}

// Packing list — extracted from booking.shipment_data.rows[] into its own table.
Table mainline_packing_cartons {
  id            varchar [pk]
  booking_id    varchar [ref: > mainline_bookings.id]
  ctn_number    integer
  leg_id        varchar [ref: > mainline_po_legs.id]
  sku_code      varchar [ref: > product_skus.sku_code]
  pcs_per_ctn   integer
  unit_price    decimal
  total_usd     decimal
  net_weight_kgs decimal
  gross_weight_kgs decimal
  measure_cm    varchar
  // summary{} is a VIEW (SUM over these rows), never a stored table.
}

// A shipment is ONE physical movement = one conveyance, grained on
// (booking, facility, mode). Legs sharing all three — incl. different allocation
// channels (NRI US "Reserved" + "First") — collapse into one shipment so the
// forwarder edits the shared logistics facts ONCE; an Air leg and a Sea leg to the
// same facility stay SEPARATE shipments. Booking guard G3 enforces a booking's legs
// share one (supplier, facility, mode) up front. Header carries only shipment-owned
// fields; the PO legs it carries are in the junction. COO/CRD are per-leg (joined).
Table mainline_shipments {
  id            varchar [pk]
  shipment_number varchar [unique, not null]            // own sequence (SHP-N), not the booking #
  booking_id    varchar [ref: > mainline_bookings.id]   // booking 1 : N shipments (one per facility+mode)
  facility_id   varchar [ref: > warehouse_facilities.id]  // physical destination (grouping key)
  mode_id       varchar [ref: > modes.id]                 // conveyance (grouping key)
  status_id     varchar [ref: > statuses.id]
  container_type_id varchar [ref: > container_types.id]   // FCL/LCL (Sea); null for Air
  pol_port_id   varchar [ref: > ports.id]                 // Departure Port
  pod_port_id   varchar [ref: > ports.id]                 // Arrival Port
  bl_no         varchar                                   // ocean bill of lading number
  // ACTUAL carrier for this conveyance (stamped from the booking at approve,
  // correctable after). Drives the landed-cost BASIS via couriers
  // .provides_cost_invoices: a FedEx/DHL shipment is estimated from the CI value,
  // a forwarder shipment uses the actual freight/duty typed below.
  // NULL on rows created before 2026-08-24 → treated as ACTUAL, so historical
  // shipments and their posted landed costs are unaffected.
  courier_id    varchar [ref: > couriers.id]
  // The carrier's OWN reference for this shipment. Was `ceva_shipment_number`,
  // which hardcoded one carrier's name into the schema — the carrier is now data
  // (courier_id above), so the column no longer names it. Distinct from
  // `shipment_number` (SHP-N), which is the portal's own sequence.
  carrier_reference varchar                                // manually entered
  customs_entry_number varchar                            // customs clearance entry #, manually entered
                                                          // (pushed as custbody_tt_customs_entry_number)
  // SHARED ocean logistics dates — edited once for the whole consignment:
  etd_pol       date
  eta_pod       date
  e_del         date
  cargo_received_date date                                // "received at port"
  ata                 date                                // ACTUAL receipt date ("received in system");
                                                          // manual now / NetSuite item-receipt later. Nullable.
                                                          // Expected ATA = e_del + 5 is DERIVED (view), never stored.
  netsuite_id   varchar
  // shipment-level financials (one customs entry per physical shipment):
  invoice_value decimal
  duty          decimal
  freight       decimal
}

// Junction (shipment ↔ PO leg). Per-leg facts (lot, allocated qty) live here; the
// leg's allocation channel is derived via leg → po_order → allocation_channels.
Table mainline_shipment_legs {
  id            varchar [pk]
  shipment_id   varchar [ref: > mainline_shipments.id]
  leg_id        varchar [ref: > mainline_po_legs.id]
  lot_number    integer
  expected_quantity integer                            // this leg's booking allocation
  indexes {
    (shipment_id, leg_id) [unique]
  }
}

// NetSuite Item Receipts for MAINLINE POs — synced read-only alongside the PO sync
// (fetchNetSuiteItemReceipts scoped by po_orders.netsuite_id). Attach to the
// component po_number. Received qty is DERIVED at read from the lines (three-way
// match). Separate from sms_item_receipts (no shared transactional tables).
Table mainline_item_receipts {
  id                 varchar [pk]
  netsuite_ir_id     varchar [unique]     // internal id (push target)
  netsuite_ir_tranid varchar              // IR document number (e.g. IR65377)
  po_number          varchar [not null, ref: > po_orders.po_number]   // the receipt's source PO
  receipt_date       date
  source             varchar              // 'netsuite' | 'manual'
  // portal-owned landed-cost match: which shipment's freight/duty share posts to
  // this IR (confirmed per-PO). Preserved across sync; NetSuite facts never touch it.
  matched_shipment_id varchar [ref: > mainline_shipments.id]
  confirmed_by       varchar              // user id
  confirmed_at       timestamp
}
// The NEGATIVE of matched_shipment_id: a suggested (receipt × shipment) pair a
// human explicitly rejected ("✗ — that is not the IR for this PO"). Stored because
// the suggestion is DERIVED per read — an unrecorded "no" would be re-suggested on
// the next refresh. Excluded from both auto-match passes, so the next-best candidate
// surfaces instead. Own table, not a column: one IR can be rejected against several
// of its PO's shipments, which on the receipt row would be a repeating group.
// Mutually exclusive with matched_shipment_id for the same pair (the controllers
// clear one when the other is asserted).
Table mainline_receipt_match_rejections {
  id          varchar [pk]
  receipt_id  varchar [not null, ref: > mainline_item_receipts.id]
  shipment_id varchar [not null, ref: > mainline_shipments.id]
  rejected_by varchar              // user id
  rejected_at timestamp
  indexes {
    (receipt_id, shipment_id) [unique]
  }
}

Table mainline_item_receipt_lines {      // per-SKU received qty (from the NS IR lines)
  id         varchar [pk]
  receipt_id varchar [not null, ref: > mainline_item_receipts.id]
  sku_code   varchar [ref: > product_skus.sku_code]
  qty        integer [not null]
  indexes {
    (receipt_id, sku_code) [unique]
  }
}

// ASN = Advance Shipping Notice — the receiver's arrival notice for a PHYSICAL
// shipment, so it keys on the shipment, NOT the booking. Contents derive from the
// CI lines of ALL legs in the shipment; gate is the shipment's own e_del.
Table mainline_asns {
  id            varchar [pk]
  shipment_id   varchar [ref: > mainline_shipments.id]
  file_url      varchar
  status        varchar
  generated_at  timestamp
}


// ===========================================================================
//  SMS MODULE  (courier shipments — FedEx/DHL on tentree's account)
//
//  FULLY SEPARATE DATASET (decision 2026-07-02): SMS has its OWN PO tables
//  (sms_pos / sms_po_lines) — it shares NO transactional tables with mainline,
//  so no diagram edge can ever connect an SMS row to mainline legs/bookings/
//  shipments. Shared = reference/master data ONLY (suppliers, seasons,
//  warehouse_facilities, statuses, couriers, product_skus). The UI may show
//  mainline|sms sub-tabs in one section, but each tab is backed by its own
//  module + dataset.
//
//  Source of truth: NetSuite sync is SMS-ONLY for now (custbody_tt_po_type
//  ='smm'); mainline POs come from WIP import (mainline NS sync = future).
//
//  Workflow: NO booking step — the VENDOR enters each shipment (per-PO qty +
//  cartons, one tracking number + courier per consignment); one PO ships as
//  2–3 lots; status = courier tracking state; receiving reconciles against
//  NetSuite Item Receipts. Plan: SMS_MODULE_PLAN.md.
// ===========================================================================

Table sms_pos {                         // SMS purchase order (one NetSuite PO, courier-fulfilled)
  po_number     varchar [pk]            // tranid
  trn_number    varchar                 // custbody_tentree_po — attribute here, NOT a shared
                                        // po_masters ref; 1:1 with po_number in SMS practice
                                        // (if a TRN ever fans out, promote to sms_po_masters)
  supplier_id   varchar [ref: > suppliers.id]              // entity
  season_id     varchar [ref: > seasons.id]                // custbody7
  hod           date                    // custbody8 — handover date (the SMS "CRD")
  expected_received_date date           // t.duedate (NS "Due Date", labelled Expected Receive Date
                                        // for SMS) — the forecast's arrival anchor; incoming qty is
                                        // bucketed by ISO week of this date
  ship_method   varchar                 // custbody16 (raw NS value; courier resolved per shipment)
  approval_status varchar               // approvalstatus (synced as-is; badge in UI)
  facility_id           varchar [ref: > warehouse_facilities.id]   // location → physical facility
  allocation_channel_id varchar [ref: > allocation_channels.id]    // location → Reserved/First (nullable, e.g. Direct tentree)
  netsuite_id   varchar [unique]
}

// NetSuite-owned per-SKU ordered qty. GRAIN = the NetSuite transaction LINE, which
// is NOT the same as (po_number, sku_code): NetSuite legitimately repeats one item
// across several PO lines (split by receipt date / location, or a price-correction
// line). Live proof: PO04792 = 54 SKUs × 3 lines each, PO04697 has one SKU at both
// 26.25 and 49. (po_number, sku_code) was declared unique here until 2026-08-14 and
// 57 key groups violated it, so the index could never have been created.
// `netsuite_line_id` is that true identity — the SuiteQL already selected it
// (integrationService `tl.id AS line_id`); the sync just wasn't storing it.
// Rows synced before the fix carry a null netsuite_line_id, and Postgres permits
// multiple NULLs in a unique index, so old and new rows both load; each PO's rows
// gain their ids on its next sync (lines are rebuilt wholesale per PO).
// Every consumer aggregates per PO or per (po, sku) — see smsService.priceByPoSku
// for the deterministic price pick when one (po, sku) spans several lines.
Table sms_po_lines {
  id               varchar [pk]          // spol_ns_<netsuite_line_id> (stable across syncs)
  po_number        varchar [not null, ref: > sms_pos.po_number]
  sku_code         varchar [ref: > product_skus.sku_code]
  ordered_qty      integer
  unit_price       decimal               // per NS LINE; may differ between lines of one SKU
  netsuite_line_id varchar [unique]      // transactionline.id — the real identity; null on pre-2026-08-14 rows

  indexes {
    (po_number, sku_code)                // lookup only — NOT unique, see the note above
  }
}

// SMS BOOKING (added 2026-08-07) — an OPTIONAL authorization step. Courier
// consignments need no space reservation, so most SMS shipments are still entered
// by the vendor with NO booking (booking_id IS NULL — the original flow, unchanged).
// A booking exists when the consignment is planned/authorized up front: it gates
// approval, and it marks the shipment as one that carries a formal customs entry
// (actual freight/duty from the broker bill — see sms_shipments below).
// Vendor submits → Logistics approves; approval creates one DRAFT shipment per
// destination facility (tracking number filled in later, when the box ships).
Table sms_bookings {
  id                varchar [pk]
  booking_number    varchar [unique, not null]        // own sequence (SMS-B-N)
  supplier_id       varchar [ref: > suppliers.id]     // G1: one supplier per booking
  incoterm_id       varchar [ref: > incoterms.id]     // nullable — courier terms are often DAP/DDP
  cargo_ready_date  date                              // the SMS CRD (HOD-aligned)
  // Carrier + mode are PLANNED here and copied onto the draft shipment at approve
  // (2026-08-24). They used to not exist: approve hardcoded FedEx, and the landed
  // -cost push then tagged every SMS receipt COURIER. A booked consignment clears
  // customs formally and may well move by Ceva sea/air, so both are explicit.
  // They are INDEPENDENT — Ceva runs both sea and air, so carrier cannot derive mode.
  courier_id        varchar [ref: > couriers.id]      // FedEx / DHL / Ceva
  mode_id           varchar [ref: > modes.id]         // Sea / Air / Courier — drives NS custbody16
  booking_status_id varchar [ref: > statuses.id]      // statuses WHERE module='sms', category='booking'
  submitted_at      timestamp
  approved_at       timestamp
}

// Junction (M:N booking ↔ PO-lot). Mirrors mainline_booking_po_legs, but keys on
// (po_number, lot_number): SMS has NO air/sea legs — sms_pos IS the bookable grain,
// so there is no leg surrogate to reference.
// units here = BOOKED qty; sms_shipment_pos.units = SHIPPED qty. Two different
// facts (the variance is derived at read, never stored).
// "A lot sits on at most ONE ACTIVE booking" is a CONTROLLER GUARD, not an index:
// a Cancelled/Rejected booking must leave the lot re-bookable.
Table sms_booking_pos {
  id          varchar [pk]
  booking_id  varchar [not null, ref: > sms_bookings.id]
  po_number   varchar [not null, ref: > sms_pos.po_number]
  lot_number  integer [not null]
  units       integer [not null]
  cartons     integer
  weight_kg   decimal
  cbm         decimal

  indexes {
    (booking_id, po_number, lot_number) [unique]
  }
}

Table sms_shipments {                   // ONE physical consignment = one tracking number
  id              varchar [pk]
  courier_id      varchar [not null]    // → couriers master data (FedEx / DHL / Ceva)
  // Shipping mode (2026-08-24). NULLABLE and normally null: a vendor-entered
  // consignment is a courier parcel by definition, and the landed-cost push falls
  // back to COURIER when this is null — so the unbooked flow is untouched. It is
  // SET on a booked consignment (copied from sms_bookings.mode_id at approve),
  // where the box may actually be a Ceva sea/air movement, and it is what the
  // NetSuite push maps to custbody16 (SEA / AIR / COURIER).
  mode_id         varchar [ref: > modes.id]
  tracking_number varchar [unique]      // the courier's key; tracking poll joins on it.
                                        // NULLABLE + null-exempt from the unique check:
                                        // a booking-approved DRAFT has no number yet.
  ship_date       date
  facility_id     varchar [ref: > warehouse_facilities.id]   // destination
  manual_status_id varchar [ref: > statuses.id]  // vendor/logistics fallback while the
                                        // courier API is not connected; the DISPLAYED
                                        // status is DERIVED from sms_tracking_events
                                        // (latest event via courier_status_map) and
                                        // wins over this whenever events exist
  created_by      varchar               // user id (vendor login that entered it)
  created_at      timestamp
  // NO cartons/units here — those are per-PO facts on sms_shipment_pos;
  // consignment totals are DERIVED (Σ junction), never stored.

  // ── BOOKED consignments (added 2026-08-07) — all nullable; null on the
  //    vendor-entered flow, which is unchanged.
  booking_id      varchar [ref: > sms_bookings.id]   // NULL = vendor-entered, no booking
  // One customs entry per physical consignment — same functional dependency
  // mainline_shipments carries. Freight/duty here are ACTUALS off the broker /
  // courier bill, typed once (NO rate, NO estimate — mainline behaviour).
  // Unbooked SMS shipments keep the DERIVED CI × landed_cost_rates estimate.
  customs_entry_number varchar
  duty            decimal
  freight         decimal
  // NOT stored: invoice_value. Mainline types it in; SMS DERIVES CI value as
  // Σ(pcs × unit_price) over sms_packing_cartons, so storing it would duplicate
  // a derivable fact. The posted snapshot in landed_costs still records it.
}

Table sms_shipment_pos {                // junction: which PO-lots the consignment carries.
  id          varchar [pk]              // a FedEx shipment MAY carry multiple POs (confirmed);
  shipment_id varchar [not null, ref: > sms_shipments.id]      // lot_number counts per PO,
  po_number   varchar [not null, ref: > sms_pos.po_number]     // so it lives here: PO04686
  lot_number  integer [not null]        // lot 2 can ride with PO04690 lot 1 in one box.
  units       integer [not null]        // vendor-entered shipped qty for this PO in this box
  cartons     integer                   // vendor-entered carton count for this PO

  indexes {
    (po_number, lot_number) [unique]    // a lot ships exactly once
    (shipment_id, po_number) [unique]   // a PO appears once per consignment
  }
  // NO per-SKU shipment lines: vendors enter PO totals (confirmed workflow).
  // SKU grain exists on both sides of the reconciliation anyway
  // (sms_po_lines = ordered, sms_item_receipt_lines = received).
}

Table sms_tracking_events {             // courier integration APPENDS; rows are immutable
  id           varchar [pk]
  shipment_id  varchar [not null, ref: > sms_shipments.id]
  event_time   timestamp [not null]
  courier_code varchar [not null]       // raw carrier scan code (e.g. FedEx 'DL')
  description  varchar
  location     varchar
}

Table courier_status_map {              // carrier scan code → portal status vocabulary
  id           varchar [pk]             // (statuses rows with module='sms'); data, not code —
  courier_id   varchar [not null]       // new carrier codes are a row insert, not a deploy
  courier_code varchar [not null]
  status_id    varchar [not null, ref: > statuses.id]

  indexes {
    (courier_id, courier_code) [unique]
  }
}

Table sms_item_receipts {               // NetSuite Item Receipts (warehouse-side truth)
  id             varchar [pk]
  netsuite_ir_id varchar [unique]       // internal id — the REST push target
  netsuite_ir_tranid varchar            // IR document number (e.g. IR65377) — display/reconcile
  po_number      varchar [not null, ref: > sms_pos.po_number]
  receipt_date   date
  source         varchar                // 'netsuite' | 'manual'
  // logistics' CONFIRMED IR ↔ consignment link. The auto-guess suggestion
  // (qty match → date proximity → lot sequence) is DERIVED at read-time;
  // only the human confirmation is stored (an entered fact):
  matched_shipment_id varchar [ref: > sms_shipments.id]   // nullable until confirmed
  confirmed_by   varchar                // user id
  confirmed_at   timestamp
}

// The NEGATIVE of matched_shipment_id — see mainline_receipt_match_rejections for
// the reasoning. Kept as SMS's own table (no transactional table is shared).
Table sms_receipt_match_rejections {
  id          varchar [pk]
  receipt_id  varchar [not null, ref: > sms_item_receipts.id]
  shipment_id varchar [not null, ref: > sms_shipments.id]
  rejected_by varchar              // user id
  rejected_at timestamp
  indexes {
    (receipt_id, shipment_id) [unique]
  }
}

Table sms_item_receipt_lines {          // per-SKU received qty (from the NS IR lines)
  id         varchar [pk]
  receipt_id varchar [not null, ref: > sms_item_receipts.id]
  sku_code   varchar [ref: > product_skus.sku_code]
  qty        integer [not null]

  indexes {
    (receipt_id, sku_code) [unique]
  }
}

// The PHYSICAL box. Split out of sms_packing_cartons 2026-08-14 (2NF): these three
// facts depend on (shipment_id, ctn_number) — a proper subset of that table's
// (shipment, ctn, sku) key — so storing them per SKU row repeated one carton's
// weight across up to 30 rows. The uploader wrote the real value on the carton's
// first line and zeroed the repeats, leaving 103 of 114 cartons self-contradictory,
// so every total depended on ROW ORDER: reversing the row order changed the packing
// summary of 25 of 34 consignments, one of them from 246.2 kg to 0. Row order is
// undefined in SQL, so this had to be fixed before the Postgres migration.
// Backfill: scripts/split-sms-cartons.js (idempotent, --dry-run, refuses to write
// on any conflicting non-empty pair). Joined back onto the SKU rows at read by
// smsService.withCartonFacts. NOTE mainline_packing_cartons still has this shape.
Table sms_cartons {
  id               varchar [pk]         // sctn_<shipment>_<ctn>
  shipment_id      varchar [not null, ref: > sms_shipments.id]
  ctn_number       integer [not null]
  net_weight_kgs   decimal
  gross_weight_kgs decimal
  measure_cm       varchar              // "L x W x H"
  indexes { (shipment_id, ctn_number) [unique] }   // ctn_number alone is NOT unique — 14 values repeat across shipments
}

Table sms_packing_cartons {             // SHIPPING DATA — carton × SKU detail the
  id            varchar [pk]            // vendor uploads (one Excel per consignment).
  shipment_id   varchar [not null, ref: > sms_shipments.id]   // Source of shipped-per-SKU,
  po_number     varchar [not null, ref: > sms_pos.po_number]  // the CI and the packing list.
  ctn_number    integer                 // → sms_cartons (shipment_id, ctn_number)
  sku_code      varchar [ref: > product_skus.sku_code]
  pcs_per_ctn   integer
  unit_price    decimal                 // snapshot; deterministic default from sms_po_lines — smsService.priceByPoSku
  indexes { (shipment_id, ctn_number, sku_code) [unique] }
  // DERIVED, never stored: total_usd (= pcs_per_ctn × unit_price), shipped-per-SKU
  // (Σ pcs by po×sku), packing summary (pcs/cartons/weights/cbm/value). Unlike
  // mainline (which redundantly stores mainline_ci_line_items), SMS derives the
  // CI line items from these cartons at read-time.
  // Carton weight/measure live in sms_cartons — NOT here (see that table).
}

Table sms_documents {                   // generated CI + packing-list artifacts
  id            varchar [pk]            // (mirror mainline_documents)
  shipment_id   varchar [not null, ref: > sms_shipments.id]
  po_number     varchar [ref: > sms_pos.po_number]   // null = combined (all POs in the box)
  doc_type      varchar                 // 'commercial_invoice' | 'packing_list'
  file_url      varchar
  invoice_number varchar
  generated_at  timestamp
}

// DERIVED, never stored (same rule as mainline): shipment status (latest
// tracking event via courier_status_map, fallback manual_status_id, THEN
// Delivered → Received when every PO in the box has an sms_item_receipts row
// attributed to that lot), courier ETA (estimatedDeliveryTimeWindow from the
// poll), consignment totals (Σ junction units/cartons), per-PO fulfillment
// ("2 of 3 lots shipped"), reconciliation ordered (sms_po_lines) vs shipped
// (Σ sms_shipment_pos.units) vs received (Σ sms_item_receipt_lines) + variance,
// timeliness vs sms_pos.hod.
// statuses rows: module='sms', category='shipment' — Label Created, Picked Up,
// In Transit, Out for Delivery, Delivered, Received, Exception. 'Received'
// (sms_received) is DERIVE-ONLY: no courier_status_map code maps to it and
// manual_status_id may never hold it (the write route rejects the name) — it
// exists as a row purely for the name/colour join.


// ===========================================================================
//  IDENTITY / ACCESS  (shared)
// ===========================================================================

Table roles {
  id          varchar [pk]
  name        varchar [unique, not null]
  description varchar
  protected   boolean
}

Table role_permissions {                // resolves roles.permissions[] repeating group (1NF)
  role_id     varchar [ref: > roles.id]
  permission  varchar

  indexes {
    (role_id, permission) [pk]
  }
}

Table users {
  id          varchar [pk]
  email       varchar [unique, not null]
  password    varchar                    // scrypt:<salt>:<hash>
  name        varchar
  role_id     varchar [ref: > roles.id]  // was free-text role string
  supplier_id varchar [ref: > suppliers.id, note: 'vendor accounts only']
  must_change_password boolean
}

Table contacts {
  id          varchar [pk]
  name        varchar
  email       varchar
  phone       varchar
  company     varchar
  role        varchar
  group       varchar
}

// ===========================================================================
//  LANDED COSTS MODULE  (freight & duty — Phase 1: SMS estimates)
// ===========================================================================
//  Additive module (modules/landedcosts, routes /landed-costs). Reads the SMS
//  dataset READ-ONLY; writes ONLY these two tables. Nothing on sms_*/mainline_*
//  shipment rows changes. Freight/duty are DERIVED (CI value × rate) and shown
//  live; POSTING snapshots the estimate into landed_costs (estimate is final —
//  a later courier bill does not change it). Per-PO split is derived at read
//  (CI-value share, largest-remainder to cents), never stored.

// Editable rate per module (Settings → Landed Cost Rates). 3NF: pure master data.
Table landed_cost_rates {
  id          varchar [pk]
  module      varchar                                 // 'sms' | 'mainline' (unique per module)
  freight_pct decimal                                 // % of CI value
  duty_pct    decimal                                 // % of CI value
}

// Posted snapshot — one per (module, shipment). Absence = not yet posted.
// invoice_value + freight_pct/duty_pct + freight/duty are the POINT-IN-TIME
// posted facts (not recomputed after rates change). shipment_id is a soft ref
// into the module's own shipment table (sms_shipments for module='sms').
//
// GRAIN: keyed on the SHIPMENT, never the booking — one physical consignment is
// one customs entry. An SMS booking spanning 3 tracking numbers = 3 customs
// entries = 3 rows here (same as mainline, which also keys on shipment).
//
// BASIS (2026-08-07) — which source the posted freight/duty came from is DERIVABLE
// from the row itself, so there is no `basis` column:
//   • rate snapshot SET   → estimate (CI value × landed_cost_rates).
//                           Unbooked SMS shipments.
//   • rate snapshot NULL  → ACTUAL off the bill, read from the shipment row.
//                           Mainline, and BOOKED SMS shipments.
Table landed_costs {
  id            varchar [pk]
  module        varchar                               // 'sms' | 'mainline'
  shipment_id   varchar                               // → sms_shipments.id (module='sms')
  invoice_value decimal                               // CI value basis at posting
  freight_pct   decimal                               // rate snapshot
  duty_pct      decimal
  freight       decimal                               // posted $ (final)
  duty          decimal
  posted_by     varchar [ref: > users.id]
  posted_at     timestamp
  netsuite_pushed_at timestamp                       // when pushed to the IR (null = posted, not pushed)
  // NOTE: the pushed IR per PO is DERIVED at read from sms_item_receipts
  // (matched_shipment_id = shipment_id) — never stored here (no repeating group).
  indexes {
    (module, shipment_id) [unique]
  }
}

// ===========================================================================
//  DERIVED DATA — VIEWS ONLY (never stored, per the "never store derived" rule)
// ===========================================================================
//  po_master_totals    = SUM(po_order_lines.ordered_qty) per TRN & per SKU
//                        → the season-start "how much we'll order" ORDER INTENT.
//                        Distinct from the existing /forecast page (which is a
//                        shipment-arrival-by-week report). Surface this on the
//                        Purchase Orders module as the forecast-state view.
//  po_lifecycle_state  = forecast (no legs) | split (has legs) — derived from
//                        presence of *_po_legs rows, NOT a stored column.
//                        BOOKABLE iff state = split (legs exist).
//  leg_reconciliation  = per (po_number, sku): ordered_qty vs Σ allocated_qty
//                        → drives R2 "flag for review" on mismatch
//  mainline_packing_summary = SUM(pcs, total_usd, weights, cbm) per booking
//                        → replaces shipment_data.summary{}
//  po_fulfillment      = ordered_qty − Σ confirmed CI qty per SKU
//                        (the /fulfillment endpoint; mainline CIs only for now)
//  po_logistics_dates  = earliest/latest ACTUAL shipment dates per leg
//                        → overrides the WIP planned dates at read-time
// ===========================================================================
