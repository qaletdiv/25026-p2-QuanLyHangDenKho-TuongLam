# Copy this file to .env and fill in your details

# REQUIRED — session signing key. The server refuses to boot without it.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value invalidates every live session (all users must log in again).
JWT_SECRET=generate_a_random_value_do_not_reuse_this_placeholder

# NOTE: the FRONTEND also needs JWT_SECRET (same value) in
# frontend/tentree-scportal/.env.local — src/proxy.ts verifies the session cookie
# signature with it. Both must match or every request bounces to /login.


# Credentials the Playwright verification harness logs in with. There is deliberately
# no default admin password documented anywhere in the repo any more.
E2E_EMAIL=admin@tentree.com
E2E_PASSWORD=

# Browser origins allowed to call this API, comma separated. Defaults to
# http://localhost:3000,http://127.0.0.1:3000. Was `origin: "*"`. Nothing in the app
# is a browser->backend call any more (the Next server proxies everything), so this
# only needs the frontend origin for local tooling.
CORS_ORIGINS=http://localhost:3000

# Your Google Drive Folder ID (found in the URL when viewing the folder in your browser)
# Example: https://drive.google.com/drive/folders/1aBcDeFgHiJkLmNoPqRsTuVwXyZ
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Your Google Cloud Service Account details
# You can generate this by going to Google Cloud Console > IAM & Admin > Service Accounts > Create Key (JSON)
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nSuper\nLong\nKey\nHere\n-----END PRIVATE KEY-----\n"

# Anthropic API — used for freight PDF parsing (Claude Haiku)
ANTHROPIC_API_KEY=sk-ant-...

# NetSuite — OAuth 1.0 Token-Based Authentication (TBA)
# Consumer Key/Secret: Setup > Integrations > Manage Integrations > your integration record
# Token ID/Secret: Setup > Users/Roles > Access Tokens > New Access Token
NETSUITE_ACCOUNT_ID=4297852-sb1
NETSUITE_CONSUMER_KEY=your_consumer_key_here
NETSUITE_CONSUMER_SECRET=your_consumer_secret_here
NETSUITE_TOKEN_ID=your_token_id_here
NETSUITE_TOKEN_SECRET=your_token_secret_here

# ---------------------------------------------------------------------------
# Data backend (2026-09-14 Postgres migration)
#   postgres  real tables generated from database.dbml (default) — see backend/db/
#   json      the original files under backend/data/. These are a FROZEN snapshot
#             from migration day once the app has been writing to Postgres, not a
#             live mirror, so switching back moves the portal to that snapshot.
#
# Create + load:  node db/buildSchema.js && node db/migrate.js
# ---------------------------------------------------------------------------
DATA_BACKEND=postgres
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/tentree_portal

# ---------------------------------------------------------------------------
# Notification email (2026-09-25) — sent when a booking, shipment or Item
# Receipt match is saved. Who gets what is role-based; see
# modules/notifications/emailRecipients.js.
#
# WITH NO SMTP_HOST SET, NOTHING IS SENT: messages are written as .eml files to
# backend/storage/outbox/ instead. That is the default and it is safe to leave
# that way — the feature is fully reviewable with no credentials and no spend,
# and goes live the moment SMTP_HOST is filled in.
#
#   EMAIL_NOTIFICATIONS=off   kill switch — nothing sent, nothing written
#   SMTP_HOST set             real SMTP delivery
#   neither                   outbox (.eml files on disk)
#
# tentree.com IS ON GOOGLE WORKSPACE (confirmed from its MX records), so Gmail
# SMTP is the path. Verified reachable from the app host: 587 and 465 both open,
# STARTTLS negotiates, and the server answers 535 to a bad password — i.e. the
# only missing piece is a valid credential.
#
#   Gmail / Google Workspace  smtp.gmail.com:587, SMTP_USER=you@tentree.com and
#                             SMTP_PASS = a 16-char APP PASSWORD (myaccount
#                             .google.com/apppasswords — requires 2-Step
#                             Verification ON for that account). Your normal
#                             password will NOT work. ~2,000 messages/day.
#                             ⚠️ A Workspace admin can DISABLE app passwords
#                             org-wide. If that page says "not available for your
#                             account", use the relay below instead.
#   Workspace SMTP relay      smtp-relay.gmail.com:587 — the proper fit for an
#                             app. No app password (IP-allowlisted), and it may
#                             send as ANY address in the domain, so a real
#                             no-reply@ sender becomes possible. Needs an admin
#                             to add the server IP under Apps > Gmail > Routing.
#   Brevo (ex-Sendinblue)     smtp-relay.brevo.com:587, 300/day free, no card.
#
# ⚠️ GMAIL REWRITES THE FROM HEADER to the authenticated account. Setting
#    SMTP_USER=lam.le@tentree.com with MAIL_FROM=no-reply@tentree.com does NOT
#    error — the mail simply arrives from lam.le@, and replies land in that
#    personal inbox. Keep MAIL_FROM equal to SMTP_USER unless the address is a
#    verified "Send mail as" alias, or use the relay above.
#
# ⚠️ Port 587 uses STARTTLS and SMTP_SECURE must stay false. Only 465 is
#    implicit TLS. Setting secure=true on 587 makes the handshake HANG rather
#    than fail, which looks like "email is slow" instead of a config error.
# ---------------------------------------------------------------------------
# EMAIL_NOTIFICATIONS=off
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=supplychain@tentree.com
# SMTP_PASS=your_16_char_app_password
# Must match SMTP_USER on Gmail — see the From-rewrite warning above.
# MAIL_FROM=tentree Supply Chain Portal <lam.le@tentree.com>
# ⚠️ DEV SAFETY VALVE — SET THIS ON EVERY NON-PRODUCTION HOST.
# The recipient list is resolved from the live users table and includes
# ff1@ceva.com, an EXTERNAL freight forwarder. Without this, one test edit on a
# dev box emails a partner company about a shipment that did not change, with
# links to localhost they cannot open, and there is no recall. With it set, all
# mail goes to this one address and names its real recipients in the body;
# the audit log records them as "intended" and the status reads "redirected".
# Rule of thumb: if APP_URL is localhost, this must be set.
MAIL_REDIRECT_TO=you@tentree.com

# Used to build the "View" link in the message body.
APP_URL=http://localhost:3000
